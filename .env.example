# ─── AI Provider (pick ONE) ───────────────────────────
# Google Gemini (AI Studio / Cloud Console)
GEMINI_API_KEY=
# or: GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# OpenRouter / any OpenAI-compatible endpoint
# OPENAI_API_KEY=your-openrouter-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ─── Model Override (optional) ────────────────────────
# AI_MODEL_PHASE1=gemini-2.5-flash
# AI_MODEL_PHASE2=gemini-2.5-flash-lite

# ─── Scraping ────────────────────────────────────────
FIRECRAWL_API_KEY=

# ─── Database (Turso / LibSQL) ───────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Rate Limiting & Quota ───────────────────────────
BLEP_DAILY_LIMIT=3
BLEP_ABUSE_DAILY_LIMIT=10
BLEP_COOLDOWN_SECONDS=15
BLEP_CACHE_TTL_HOURS=24
BLEP_HASH_SALT=change-me-local-dev
BLEP_USE_MOCK=true
BLEP_DEMO_MODE=false
BLEP_PROMPT_VERSION=v1
