GEMINI_API_KEY=
FIRECRAWL_API_KEY=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

BLEP_DAILY_LIMIT=2
BLEP_ABUSE_DAILY_LIMIT=10
BLEP_COOLDOWN_SECONDS=15
BLEP_CACHE_TTL_HOURS=24
BLEP_HASH_SALT=change-me-local-dev
BLEP_USE_MOCK=true # Set to true to use mock responses for testing without hitting real APIs
BLEP_DEMO_MODE=false # Set to true to unleash live demo mode with latest Gemini model
BLEP_PROMPT_VERSION=v1

GEMINI_MODEL_MAIN=gemini-3.1-flash-lite # The main Gemini model to use
GEMINI_MODEL_BACKUP=gemini-2.5-flash-lite # Backup if main model is unavailable or rate-limited
GEMINI_MODEL_DEMO=gemini-3.5-flash # Preserve for live demo
